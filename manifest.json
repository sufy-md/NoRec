{
    "manifest_version": 2,
    "name": "No Rec",
    "version": "1.1",

    "description": "Removes 'Recommended' section from YouTube video pages.",

    "content_scripts" : [
        {
            "matches": ["*://www.youtube.com/*"],
            "css": ["noRec.css"],
            "run_at": "document_start"
        }
    ],

    "browser_specific_settings": {
        "gecko": {
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}